<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site1.master.cs" Inherits="WebApplicationTicketSupport.Site1" %>

<!DOCTYPE html>
<html>
<head>
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server" /></title>
   <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.4.0/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.13/jspdf.plugin.autotable.min.js"></script>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.3/dist/umd/popper.min.js"></script>
     <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
     <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <style>
        /* Estilos para el contenedor fijo del dashboard */
         body{
              overflow:hidden;
               
          }
        .fixed-dashboard {
            position: fixed;
            top: 54px; /* Ajuste para que no se superponga con la navbar */
            left: 0;
            width: 140px; /* Ancho del dashboard */
            height: calc(100vh - 56px); /* Altura restante de la ventana */
            background-color: #f8f9fa; /* Color de fondo */
            padding: 10px;
        }

        .fixed-dashboard a {
            display: block;
            padding: 10px;
            text-decoration: none;
            color: #333;
        }

        .fixed-dashboard a:hover {
            background-color: #e9ecef;
        }

        /* Estilos para el contenido principal */
        .main-content {
            margin-left: 200px; /*Ajuste para el contenido principal */
            padding: 20px;
            overflow: auto; /* O overflow: scroll; */
            height: 600px;
        }   
        
        
        .login-container{
            margin-left: 300px;
            margin-top: 50px;   
           
        }
        
        .register-container{
             margin-left: 300px;
             margin-top: 30px; 
            
        }
        #spark{
            margin-left: 15px;
            /*font-family: "Segoe UI";
            font-size: 24px;*/
        }
        .star{
             width: 18%; /* La imagen ocupará el 50% del ancho de su contenedor */
            height: auto;
        }
        #Navtop{
            position: sticky;
            z-index: 100;
        }
        .Favicon{
             width: 18%;
             height: auto;
             width: 10%;
        }
        .divimg{
             display: flex;
             align-items:center;
        }

        .asignados{
             margin-right: 50px;
        }

        .btnamarillo{
            padding-top:10px;
        }
        
        .ticket-status p {
            font-size: 1.5em;
            font-weight: bold;
        }


    </style>
</head>
<body>
    <form runat="server">
        <nav id="Navtop" class="navbar navbar-expand-lg navbar-dark" style="background-color: purple;">
            <span id="spark" class="navbar-text text-white" >
                <img class="star"  src="Imagenes/Star%20V3%20(1).png" />
                Spark-MS
            </span>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNavDropdown" aria-controls="navbarNavDropdown" aria-expanded="false" aria-label="Toggle navigation" >
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-end" id="navbarNavDropdown">
                <ul class="navbar-nav" runat="server" id="menuDesplegable">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownMenuLink" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                           Cerrar Sesion
                        </a>
                        <div class="dropdown-menu" aria-labelledby="navbarDropdownMenuLink">
                            <asp:LinkButton ID="lnkSalir" runat="server" CssClass="dropdown-item" OnClick="lnkSalir_Click">Salir</asp:LinkButton>
                        </div>
                    </li>
                </ul>
            </div>
        </nav>
       

       <div runat="server" id="SidebarPanel" class="fixed-dashboard">
        <div class="divimg"> <img class="Favicon"  src="Imagenes/home.png" /> <a href="Cliente.aspx">Home</a> </div>
        <div runat="server"  id="adminicon" class="divimg"> <img class="Favicon"src="Imagenes/Management.png" />  <a runat="server" id="AdminLink" href="AdminDashboard.aspx">Admin</a></div>
        <div runat="server"  id="usericon" class="divimg"> <img  class="Favicon" src="Imagenes/User%20V4.png" />  <a runat="server" id="UsuariosLink" href="Usuarios.aspx">Usuarios</a></div>
        <div class="divimg"> <img class="Favicon" src="Imagenes/Service%20V2.png" />  <a runat="server" id="TecnicosLink" href="Tecnico.aspx">Técnicos</a></div>
        <div runat="server" id="histoicon" class="divimg"> <img   class="Favicon" src="Imagenes/note.png" />  <a runat="server" id="HistorialLink" href="Historial.aspx">Historial</a></div>
   <div class="divimg"><img class="Favicon" src="Imagenes/Close%20V2.png" /> <asp:LinkButton ID="lnkSalirSidebar" runat="server" OnClick="lnkSalir_Click">Salir</asp:LinkButton>
</div></div>
       
        <div class="main-content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
          
        </div>
    </form>
</body>
</html>